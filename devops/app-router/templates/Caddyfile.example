# Hermes Mini-App Router — Caddyfile
#
# Caddy listens on 127.0.0.1:8080 and routes path prefixes to local PM2 apps.
# Tailscale Serve fronts this with HTTPS on the tailnet.
#
# Conventions:
#   - port 3000 = auth-service
#   - port 8080 = this Caddy
#   - apps start at port 3001 and increment
#
# After editing: `caddy reload --config <this-file> --adapter caddyfile`

:8080 {
    bind 127.0.0.1 ::1

    # Auth service endpoints (login form, verify, logout).
    handle /auth/* {
        reverse_proxy 127.0.0.1:3000
    }

    # Cheap liveness probe; useful for `curl <host>:4242/health`.
    handle /health {
        respond "ok" 200
    }

    # ── Gateway webhook routing (optional) ────────────────────────────────
    # Front the messaging gateway hooks server with bearer injection so
    # external callers (AgentMail Svix, iOS Shortcuts, etc.) can POST
    # without sending Authorization headers. Set GATEWAY_HOOK_TOKEN in
    # the Caddy process environment (e.g., via PM2 ecosystem env), then
    # uncomment this block.
    #
    # handle /hooks/* {
    #     reverse_proxy 127.0.0.1:<gateway-port> {
    #         header_up Authorization "Bearer {env.GATEWAY_HOOK_TOKEN}"
    #     }
    # }

    # ── Open app: no password, just a path → port mapping. ────────────────
    handle /my-open-app/* {
        uri strip_prefix /my-open-app
        reverse_proxy 127.0.0.1:3001
    }

    # ── Password-protected app: forward_auth runs first, redirects to login
    #    on 401, then strips the prefix and proxies through. ──────────────
    handle /my-private-app/* {
        forward_auth 127.0.0.1:3000 {
            uri /auth/verify?app=my-private-app
            copy_headers Cookie
            @unauthorized status 401
            handle_response @unauthorized {
                # {http.request.uri.path} avoids encoding `&` from query strings
                # breaking the `next` parameter. Query params are not preserved
                # in the redirect; after login the user lands at the page root.
                redir * /auth/login?app=my-private-app&next={http.request.uri.path} 302
            }
        }
        uri strip_prefix /my-private-app
        reverse_proxy 127.0.0.1:3002
    }

    # ── Fail closed on credential and config probes. ──────────────────────
    # This router is the one deliberately public surface (see
    # scripts/tailscale-serve.json: a funnel'd port is fully public), and
    # public hosts are scanned continuously for the credential paths that
    # AI coding tools write to disk. Scanners impersonate known AI bot
    # user-agents and do not honor robots.txt, so neither is a control.
    #
    # Caddy's file_server has no implicit dot-prefix deny, and the
    # catch-all below uses try_files, so an unmatched path falls through
    # to the SPA index instead of 404ing. Nothing legitimate under this
    # router is a dotfile or a secrets blob, so refuse the whole class.
    #
    # These use path_regexp, not path globs, on purpose: a glob has to
    # name each directory depth (/.* /*/.* and so on) and anything deeper
    # than the deepest listed glob is served. The regexes are depth
    # independent. Keep both blocks after every app handle above so they
    # cannot shadow an app prefix, and return 404 rather than 403 so a
    # probe cannot tell "exists but blocked" from "does not exist".

    # Any path segment beginning with a dot, at any depth. /.well-known
    # is exempt because ACME and other discovery standards live there.
    @dotfile_probe {
        not path /.well-known/*
        path_regexp (^|/)\.
    }
    handle @dotfile_probe {
        respond 404
    }

    # Well-known secrets filenames at any depth, case insensitive.
    # The trailing /? is load bearing. Caddy's file_server answers a
    # directory-style request for an existing file with a 308 redirect to
    # the slash-less form, and answers a nonexistent one with the SPA
    # index. Without /? the matcher misses /credentials.json/ and that
    # 308-versus-200 split becomes an existence oracle: a probe learns
    # the file is there without ever reading it. Matching the slash form
    # here 404s both cases identically.
    @secrets_probe {
        path_regexp (?i)(^|/)([^/]*\.(env|tfstate|pem|key)(\.[^/]*)?|credentials\.json|secrets\.(json|ya?ml)|key\.json|service[-_]account\.json|serviceaccountkey\.json|firebase-(adminsdk|service-account)\.json|rclone\.conf|dockerfile|docker-compose\.ya?ml)/?$
    }
    handle @secrets_probe {
        respond 404
    }

    # ── Catch-all app index. Anything not matched above lands here.
    #    Rooted at router/public so the rendered Caddyfile, restore
    #    scripts, and logs stay out of the public web root. ─────────────
    handle {
        root * "<MINI_APPS_DIR>/router/public"
        try_files {path} /index.html
        file_server
    }
}
